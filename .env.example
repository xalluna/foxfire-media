# FoxfireMedia runtime configuration. Copy to .env and replace every value.
# The server refuses to start while any secret still looks like a placeholder.
# Generate each secret with:   openssl rand -base64 48

# --- Database -------------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-me-postgres-password

# --- Public origin (used for every absolute URL: upload and embed links) -------------------
PublicBaseUrl=https://media.example.com

# --- Token signing key (embed, playback, upload, poster tokens) ----------------------------
Signing__Key=replace-me-with-openssl-rand-base64-48
# During rotation, put the old key here so outstanding tokens keep working:
# Signing__PreviousKey=

# --- Application API keys: ApiKeys__<Name>, one per entry in config/appsettings.json ------
# Keys are only ever read from the environment; a key in any config file aborts startup.
ApiKeys__Foxfire=replace-me-with-openssl-rand-base64-48
# Zero-downtime rotation: add the new key as secondary, move the app over, then promote it.
# ApiKeysSecondary__Foxfire=

# --- First admin account (created only while no admin exists) ----------------------------
Admin__BootstrapUsername=admin
Admin__BootstrapPassword=replace-me-with-a-long-unique-password
# Locked out? Set this for one restart to reset the bootstrap admin's password to the value above.
# Admin__ResetBootstrapPassword=true

# --- Optional -------------------------------------------------------------------------------
# MEDIA_PATH=/mnt/media            # host directory (dedicated disk) for media
# FOXFIRE_PORT=8080
# APT_MIRROR=http://azure.archive.ubuntu.com
# Media__MaxHeight=1080            # transcode sources taller than this (off by default)
# Media__MaxBitrateKbps=12000      # transcode sources above this bitrate (off by default)
# Processing__Concurrency=1
# Processing__KeepSource=true      # keep originals after encoding (default)
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true   # when running behind a TLS-terminating reverse proxy
